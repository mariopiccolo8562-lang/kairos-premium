<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="120">
    <item android:state_focused="true"><shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#33D4AF37" android:endColor="#1A1E1E26" /><corners android:radius="12dp" /><stroke android:width="2dp" android:color="@color/gold_hi" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="@color/surface2" /><corners android:radius="12dp" /><stroke android:width="2dp" android:color="@color/accent" /></shape></item>
