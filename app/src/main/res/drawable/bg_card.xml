<?xml version="1.0" encoding="utf-8"?>
<!-- Kairos Premium: cornice oro con bagliore sulla locandina selezionata -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="120">
    <item android:state_focused="true"><layer-list>
        <item><shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="12dp" /><stroke android:width="6dp" android:color="#33D4AF37" /></shape></item>
        <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"><shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="10dp" /><stroke android:width="2.5dp" android:color="@color/gold_hi" /></shape></item>
    </layer-list></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="12dp" /><stroke android:width="2.5dp" android:color="@color/gold_hi" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="12dp" /></shape></item>
</selector>
