<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="120">
    <item android:state_focused="true"><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#FFF5D77A" android:centerColor="#FFD4AF37" android:endColor="#FFA8801E" /><corners android:radius="20dp" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#FFF5D77A" android:centerColor="#FFD4AF37" android:endColor="#FFA8801E" /><corners android:radius="20dp" /></shape></item>
    <item android:state_activated="true"><shape android:shape="rectangle"><solid android:color="#26D4AF37" /><stroke android:width="1dp" android:color="@color/accent" /><corners android:radius="20dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="@color/surface" /><corners android:radius="20dp" /></shape></item>
</selector>
